# Copy to .env, then load values in your shell before starting uvicorn.
OLLAMA_URL=http://127.0.0.1:11434
SMALL_MODEL=llama3.2:1b
LARGE_MODEL=llama3.2:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CACHE_THRESHOLD=0.88
REQUEST_TIMEOUT_SECONDS=120
NUM_PREDICT=384
OLLAMA_KEEP_ALIVE=5m
MAX_CONCURRENT_INFERENCES=1
DB_PATH=rag_router.db
# Optional estimates only. Ollama itself has no per-request API charge.
SMALL_MODEL_ESTIMATED_COST=0
LARGE_MODEL_ESTIMATED_COST=0
